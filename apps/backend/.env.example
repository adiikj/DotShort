[TEMPLATE]
PORT=8000
# Local dev: docker-compose.yml (port 5434). For Neon, paste your connection
# string here: postgres://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://dotshort:password@127.0.0.1:5434/dotshort
CORS_ORIGIN=http://localhost:3000
# Publicly-visible base URL for generated short links (set to your prod domain in production)
APP_BASE_URL=http://localhost:8000
# "development" | "production": controls secure cookies and error stack traces
NODE_ENV=development
# Number of trusted proxies in front of the API (1 behind Render/Railway/nginx, 0 locally)
TRUST_PROXY=0
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d
